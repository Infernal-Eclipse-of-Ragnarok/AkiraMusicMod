		SoulofEternityInterlude: {
			Label: Soul of Eternity Interlude
			Tooltip:
				'''
				Plays End of Story by Sakuzyo when you have the Soul of Eternity equiped and there are no bosses or events
				This does nothing if you don't have Fargo's Soul Mod enabled
				'''
		}

