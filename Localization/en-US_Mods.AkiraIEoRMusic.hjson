Configs: {
	MusicConfig: {
		VanillaCalamityWoF: {
			Label: Prioritize Vanilla Calamity Music for Wall of Flesh
			Tooltip:
				'''
				Plays Fated Insurrection instead of One's Ending, Another's Beginning if you have both Vanilla Calamity Mod Music & Infernum Mode Music enabled
				This setting does nothing if you don't have both of the mods mentioned above enabled
				'''
		}

		DisplayName: Music Config

		DukeFishron: {
			Label: Duke Fishron
			Tooltip: Replaces Duke Fishron's music with Sewer Creature from Pressure
		}

		Pillars: {
			Label: Pillars
			Tooltip: Replaces the Luanr Pillar music with Dark Fountain (Titan Spawn) by fluffyhairs & Toby Fox
		}

